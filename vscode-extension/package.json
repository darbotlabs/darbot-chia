{
  "name": "darbot-chia",
  "displayName": "Darbot Chia",
  "description": "MCP connector for Chia blockchain development and operations",
  "version": "0.1.0",
  "publisher": "darbotlabs",
  "author": "Darbot Labs",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/darbotlabs/darbot-chia"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other",
    "Extension Packs"
  ],
  "keywords": [
    "chia",
    "blockchain",
    "mcp",
    "cryptocurrency",
    "wallet"
  ],
  "main": "./dist/extension.js",
  "icon": "assets/icon.png",
  "contributes": {
    "commands": [
      {
        "command": "darbotChia.connect",
        "title": "Connect to Chia Node",
        "category": "Darbot Chia"
      },
      {
        "command": "darbotChia.disconnect",
        "title": "Disconnect from Chia Node",
        "category": "Darbot Chia"
      },
      {
        "command": "darbotChia.getBlockchainState",
        "title": "Get Blockchain State",
        "category": "Darbot Chia"
      },
      {
        "command": "darbotChia.getWallets",
        "title": "Get Wallets",
        "category": "Darbot Chia"
      },
      {
        "command": "darbotChia.showTools",
        "title": "Show Available MCP Tools",
        "category": "Darbot Chia"
      }
    ],
    "configuration": {
      "title": "Darbot Chia",
      "properties": {
        "darbotChia.mcpServer.host": {
          "type": "string",
          "default": "localhost",
          "description": "MCP server hostname"
        },
        "darbotChia.mcpServer.port": {
          "type": "number",
          "default": 8550,
          "description": "MCP server port"
        },
        "darbotChia.mcpServer.useSSL": {
          "type": "boolean",
          "default": false,
          "description": "Use SSL/TLS for MCP server connection"
        },
        "darbotChia.autoConnect": {
          "type": "boolean",
          "default": false,
          "description": "Automatically connect to MCP server on extension activation"
        }
      }
    },
    "views": {
      "explorer": [
        {
          "id": "darbotChiaExplorer",
          "name": "Chia Blockchain",
          "when": "darbotChia.connected"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "darbotChia",
          "title": "Darbot Chia",
          "icon": "assets/activity-bar-icon.png"
        }
      ]
    }
  },
  "activationEvents": [
    "onCommand:darbotChia.connect"
  ],
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@types/node": "^18.x",
    "typescript": "^4.9.4"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "ws": "^8.14.0"
  }
}